{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Fortran",
            "type": "shell",
            "command": "gfortran",
            "args": [
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Run Fortran",
            "type": "shell",
            "command": "${fileDirname}/${fileBasenameNoExtension}",
            "dependsOn": "Build Fortran",
            "group": {
                "kind": "test",
                "isDefault": true
            }
        }
    ]
}